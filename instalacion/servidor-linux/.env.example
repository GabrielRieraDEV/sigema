# =============================================================================
# SIGEMA - Variables del servidor Docker (Linux)
#
# Copie este archivo como  .env  y cambie la contrasena.
#     cp .env.example .env
#
# IMPORTANTE: La contrasena que ponga aqui es la MISMA que debe ir en el
# config.ini de cada computadora cliente (campo "Contrasena BD").
# =============================================================================

# Contrasena del usuario de la base de datos. CAMBIELA por una segura.
POSTGRES_PASSWORD=cambiar_esta_clave

# (Opcional) No es necesario modificar estos valores.
POSTGRES_USER=sigema_user
POSTGRES_DB=sigema
